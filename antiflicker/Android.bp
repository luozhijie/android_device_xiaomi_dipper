android_app {
    name: "DipperAntiFlicker",

    srcs: ["src/**/*.java"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    static_libs: [
        "org.lineageos.platform",
    ],

    optimize: {
        optimize: true,
        proguard_flags_files: ["proguard.flags"],
    },
}
